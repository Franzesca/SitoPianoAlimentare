rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ilMioHousehold() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /households/{hid} {
      // la lettura è aperta a chiunque sia loggato: serve per validare un codice
      // famiglia PRIMA di essere ufficialmente membri (altrimenti nessuno potrebbe
      // mai unirsi). Il documento non contiene dati sensibili (solo chi l'ha
      // creato e quando) — i dati veri (pasti, dispensa, peso) restano protetti
      // dalle regole sotto, che richiedono la vera appartenenza.
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }
    match /households/{hid}/stato/{doc} {
      allow read, write: if request.auth != null && ilMioHousehold() == hid;
    }
    match /households/{hid}/scorte/{doc} {
      allow read, write: if request.auth != null && ilMioHousehold() == hid;
    }
    match /households/{hid}/importanza/{doc} {
      allow read, write: if request.auth != null && ilMioHousehold() == hid;
    }
    match /households/{hid}/pastiExtra/{doc} {
      allow read, write: if request.auth != null && ilMioHousehold() == hid;
    }
    match /households/{hid}/wishlist/{doc} {
      allow read, write: if request.auth != null && ilMioHousehold() == hid;
    }
    match /households/{hid}/pesi/{doc} {
      allow read: if request.auth != null && ilMioHousehold() == hid;
      allow create: if request.auth != null && ilMioHousehold() == hid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && ilMioHousehold() == hid
        && resource.data.uid == request.auth.uid;
    }
  }
}
